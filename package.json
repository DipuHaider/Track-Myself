{
  "name": "track-myself",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=4096 next build",
    "start": "next start",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "check:env": "node scripts/check-env-example.mjs",
    "verify": "npm run typecheck && npm run lint && npm run check:env && npm run test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "cross-env VITEST_DB=1 vitest run --config vitest.db.config.ts",
    "typecheck:ext": "npm --prefix browser-extension run typecheck",
    "typecheck:mcp": "npm --prefix mcp-server run typecheck"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "@react-pdf/renderer": "^4.9.0",
    "@sentry/nextjs": "^11.8.0",
    "bcryptjs": "^3.0.3",
    "docx": "^9.11.0",
    "geist": "^1.8.1",
    "jszip": "^3.10.2",
    "lucide-react": "^1.58.0",
    "mongoose": "^9.11.2",
    "next": "^16.4.2",
    "next-auth": "^4.24.14",
    "pdf-lib": "^1.17.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "^3.10.1",
    "resend": "^6.33.0",
    "sonner": "^2.0.8",
    "swr": "^2.5.1",
    "unpdf": "^1.9.0",
    "word-extractor": "^1.0.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "^16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  }
}
