# ── Required ─────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/job-tracker?retryWrites=true&w=majority
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-secret
NODE_ENV=development

# ── Recommended ──────────────────────────────────────────────────────────────
# Canonical origin used for sitemap.xml, robots.txt and Open Graph tags.
# Set this in production or those URLs point at the wrong host.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Optional ─────────────────────────────────────────────────────────────────
# Google OAuth — create at https://console.cloud.google.com → APIs & Services → Credentials
# Leave blank to offer email/password sign-in only.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Powers AI CV tailoring (/api/cv/adapt) and banner briefs (/api/tools/banner-brief).
# Without it those two endpoints return 503; the rest of the app is unaffected.
ANTHROPIC_API_KEY=

# Restricts the browser extension's CORS allowlist to a single origin.
# Defaults to "*" when unset.
EXTENSION_ORIGIN=
