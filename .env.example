# ── Required ─────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/job-tracker?retryWrites=true&w=majority
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-secret
NODE_ENV=development

# ── Recommended ──────────────────────────────────────────────────────────────
# Canonical origin used for sitemap.xml, robots.txt and Open Graph tags.
# Set this in production or those URLs point at the wrong host.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Optional ─────────────────────────────────────────────────────────────────
# Development only. Set to 1 behind a corporate TLS-inspection proxy to disable
# certificate verification for this dev process (Google OAuth, model APIs,
# Atlas). Ignored in production; a warning is printed whenever it engages.
DEV_INSECURE_TLS=

# Google OAuth — create at https://console.cloud.google.com → APIs & Services → Credentials
# Leave blank to offer email/password sign-in only.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── AI providers ─────────────────────────────────────────────────────────────
# Anthropic is the PRIMARY provider. When set it powers AI CV tailoring for every
# entitled user: the CV Builder's "AI Tailor" button (/api/cv/adapt) and the review
# step behind My Applications -> Docs -> Generate (/api/user/cv/generate/preview).
# It also powers banner briefs (/api/tools/banner-brief).
ANTHROPIC_API_KEY=

# Gemini is a personal RETRY for the superadmin only — it spends one individual's
# own quota, so it is never offered to other accounts. The gateway tries it once
# after a shared (Anthropic/OpenAI) call fails upstream; it never replaces a
# missing shared key. With no shared key at all, AI features fall back to their
# non-AI mode and say so on screen, unless the user brings their own key.
GEMINI_API_KEY=

# Optional. Defaults to gemini-3.6-flash. Set this if that model is unavailable to
# your key — a wrong id surfaces as a "Gemini 404" in the tailoring error.
GEMINI_MODEL=

# Encrypts each user's own AI API key (BYOK) at rest with AES-256-GCM. Any string of
# 16+ characters; generate one with: openssl rand -base64 32
# Deliberately separate from NEXTAUTH_SECRET so rotating session signing does not make
# every stored key undecryptable. Without it, users cannot save their own key and the
# BYOK form says so; existing shared-key AI is unaffected.
AI_KEY_SECRET=

# Optional. Comma-separated host names a user may point an OpenAI-compatible key
# at (e.g. openrouter.ai,api.groq.com). Unset allows any public https host; private
# and cloud-metadata addresses are always refused.
AI_BASEURL_ALLOWLIST=

# Second shared AI provider, used only if you enable a model that needs it in
# /settings. GPT-6 Luna is roughly a tenth the cost of the Claude models per
# token, but adding this key alone changes nothing — the model must also be
# switched on. Without it those models stay unavailable and the enabled Claude
# model is used instead.
OPENAI_API_KEY=

# One extra explicit origin allowed on the extension API, besides the ids below.
# Usually blank.
EXTENSION_ORIGIN=

# Comma-separated Chrome extension IDs allowed to receive a sign-in from
# /extension/connect and to call the extension API (Chrome Web Store ID, plus
# any unpacked dev IDs — chrome://extensions shows them). REQUIRED in production:
# unset, every id is refused there. In development any id is accepted.
EXTENSION_IDS=

# Issue-report email. Resend is used whenever RESEND_API_KEY and ISSUE_MAIL_TO are
# both set; otherwise it falls back to Web3Forms below.
# Also required for password-reset email: Web3Forms can only mail the inbox that
# owns its key, so /forgot-password does nothing without Resend.
RESEND_API_KEY=
# Where reports land. Comma-separate for several recipients.
ISSUE_MAIL_TO=
# Sender, used for BOTH issue reports and password-reset links. Needs a domain
# verified in Resend. Left blank it uses Resend's shared onboarding@resend.dev,
# which can ONLY deliver to the Resend account's own address — so password resets
# will fail for every other user until a domain is verified here.
ISSUE_MAIL_FROM=

# Fallback only. Web3Forms is a browser-form service: it throttles a server hard
# (one hour lockout) and drops reports under load. Prefer Resend above.
# The key IS the destination inbox — generate it at https://web3forms.com.
# Use the unprefixed name: NEXT_PUBLIC_* values are inlined at BUILD time, so
# changing one without a rebuild silently keeps the old value.
WEB3FORMS_ACCESS_KEY=
# Deprecated fallback, kept so existing deployments keep working.
NEXT_PUBLIC_WEB3FORMS_KEY=

# ── Observability ────────────────────────────────────────────────────────────
# Sentry error reporting. Leave blank to disable entirely (the SDK is inert
# without a DSN). Reports are scrubbed in src/lib/observability/scrub.ts: no
# request bodies, cookies, emails or CV text ever leave the server.
NEXT_PUBLIC_SENTRY_DSN=
# Build-time only, set in Vercel (not in CI): uploads source maps so stack
# traces are readable. Without SENTRY_AUTH_TOKEN the build skips the upload.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ── Billing ──────────────────────────────────────────────────────────────────
# Which adapter in src/lib/billing/ handles checkout, the customer portal and
# the webhook. "manual" (the default) means there is no payment processor:
# admins switch plans from /dashboard/users, self-service checkout answers 501
# and /pricing falls back to an upgrade request. Any other value must have a
# matching src/lib/billing/<id>.ts registered in src/lib/billing/index.ts.
BILLING_PROVIDER=manual
# Signing secret the provider adapter uses to verify /api/billing/webhook.
# Unused while BILLING_PROVIDER is manual (that route answers 404).
BILLING_WEBHOOK_SECRET=
# Price copy shown on /pricing and the Plan tab, e.g. "€4.99 / month". Build-time
# value; blank shows "Contact us".
NEXT_PUBLIC_PREMIUM_PRICE=
# Mailbox offered after an upgrade request. Blank hides the "Email us" link.
NEXT_PUBLIC_SUPPORT_EMAIL=
# External payment link (e.g. a Payoneer checkout page) offered after an upgrade
# request while billing is manual. Blank hides the button.
NEXT_PUBLIC_UPGRADE_PAY_URL=

# ── Scheduled maintenance ────────────────────────────────────────────────────
# vercel.json runs /api/cron/maintenance daily; Vercel sends this as a Bearer
# token. Any long random string — generate one with: openssl rand -base64 32
# Without it the route answers 503 and nothing scheduled runs (the trash purge
# and AI-ledger sweep still happen opportunistically on normal traffic).
CRON_SECRET=
